# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Gradle
backend/.gradle/
backend/build/
fhir-server/.gradle/
fhir-server/build/
# The wrapper jar must be committed, despite the *.jar rule above.
!backend/gradle/wrapper/gradle-wrapper.jar
!fhir-server/gradle/wrapper/gradle-wrapper.jar

# Node / Vite
frontend/node_modules/
frontend/dist/

# IDE
.idea/
